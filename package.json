{
  "name": "paseo-gitlab",
  "private": true,
  "version": "0.1.0",
  "files": [
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/loader.mjs --test test/*.test.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
    "@types/node": "^24.0.0"
  },
  "description": "A mini GitLab in the Paseo explorer: issues assigned to you, your merge requests and review requests, with descriptions, labels, threads, replies and resolve.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kern0x1b/paseo-gitlab.git"
  },
  "homepage": "https://github.com/kern0x1b/paseo-gitlab#readme",
  "bugs": {
    "url": "https://github.com/kern0x1b/paseo-gitlab/issues"
  }
}
